    {
      "id": "ecc4b810-293b-4699-bf44-014104fbd0da",
      "name": "Проверка и нормализация",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Телефон в любом формате → +7XXXXXXXXXX (то же правило, что crm.normalize_phone в боте)\nconst b = $input.first().json.body || {};\nconst raw = String(b.phone ?? '');\nconst d = raw.replace(/\\D/g, '');\nlet phone = null;\nif (d.length === 11 && '78'.includes(d[0])) phone = '+7' + d.slice(1);\nelse if (d.length === 10 && d[0] === '9') phone = '+7' + d;\nelse if (raw.trim().startsWith('+') && d.length >= 11 && d.length <= 15 && !d.startsWith('7')) phone = '+' + d;\nconst need = String(b.need ?? '').trim().slice(0, 1000) || 'Заявка с сайта';\nreturn [{ json: { name: String(b.name ?? '').trim().slice(0, 60) || 'Без имени', phone, need } }];"
      }
    },
